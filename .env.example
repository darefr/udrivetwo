# No environment variables are required for local development.
# Production: PostgreSQL, canonical HTTPS origin, and worker authentication.
DATABASE_URL=
DATABASE_CA=
APP_ORIGIN=
CRON_SECRET=
# Optional single-use first-owner setup. At least 32 random characters.
ADMIN_SETUP_TOKEN=
ADMIN_EMAIL=
# Development only. Never put this folder under public/ or commit it.
UDRIVE_DATA_DIR=.udrive
# Only set when a trusted reverse proxy replaces the incoming X-Real-IP header.
TRUST_PROXY=0
# OAuth callbacks: /api/oauth/google/callback and /api/oauth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=
# Implicit TLS SMTP URL and verified From identity. Blank = local capture in development.
SMTP_URL=
EMAIL_FROM=
# Official Meta WhatsApp Business Platform, approved utility template with TWO body parameters.
WHATSAPP_GRAPH_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=en_US
# Optional AI classification; factual answers always use the rental database.
AI_MODE=catalog
AI_MODEL=openai/gpt-5.4-mini
# Payment activation is opt-in. No mock adapter can report successful payment.
PAYMENT_PROVIDER=disabled
KHALTI_ENV=sandbox
KHALTI_SECRET_KEY=
# Test harness only: UDRIVE_MODE=test permits an isolated embedded database for local production-build tests.
# UDRIVE_MIGRATE=1 is a trusted migration-job option, not a normal app runtime setting.
# Opaque DB sessions need no signing secret. Image blobs use the same SQL database.
